generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Subscription Tier Enum for True Yield Engine access control
enum SubscriptionTier {
  FREE
  PRO
}

model User {
  id                  Int                 @id @default(autoincrement())
  name                String              @unique
  email               String              @unique
  password            String
  isAdmin             Boolean             @default(false)
  subscriptionTier    SubscriptionTier    @default(FREE)
  preferredCurrencyId Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime
  lastLogin           DateTime?
  BalanceSheet        BalanceSheet?
  CashSavings         CashSavings?
  Event               Event[]
  financialSnapshots  FinancialSnapshot[]
  IncomeStatement     IncomeStatement?
  Session             Session[]
  PreferredCurrency   Currency            @relation(fields: [preferredCurrencyId], references: [id])
}

model Session {
  id        Int      @id @default(autoincrement())
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isValid   Boolean  @default(true)
  userId    Int
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id              Int             @id @default(autoincrement())
  name            String
  amount          Decimal @db.Decimal(15, 2)
  isId            Int
  IncomeStatement IncomeStatement @relation(fields: [isId], references: [id], onDelete: Cascade)
}

model Asset {
  id           Int          @id @default(autoincrement())
  name         String
  value        Decimal @db.Decimal(15, 2)
  bsId         Int
  BalanceSheet BalanceSheet @relation(fields: [bsId], references: [id], onDelete: Cascade)
  // True Yield Engine: Assets can have linked income streams and liabilities
  linkedIncomeLines IncomeLine[]
  linkedLiabilities Liability[]
}

model Liability {
  id           Int          @id @default(autoincrement())
  name         String
  value        Decimal @db.Decimal(15, 2)
  bsId         Int
  // True Yield Engine: Optional link to an asset (e.g., mortgage linked to rental property)
  assetId      Int?
  BalanceSheet BalanceSheet @relation(fields: [bsId], references: [id], onDelete: Cascade)
  LinkedAsset  Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
}

model BalanceSheet {
  id        Int         @id @default(autoincrement())
  userId    Int         @unique
  Asset     Asset[]
  User      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  Liability Liability[]
}

model IncomeLine {
  id              Int             @id @default(autoincrement())
  name            String
  amount          Decimal @db.Decimal(15, 2)
  type            String
  isId            Int
  quadrant        String?
  // True Yield Engine: Optional link to an asset (e.g., rent income linked to rental property)
  assetId         Int?
  IncomeStatement IncomeStatement @relation(fields: [isId], references: [id], onDelete: Cascade)
  LinkedAsset     Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
}

model IncomeStatement {
  id         Int          @id @default(autoincrement())
  userId     Int          @unique
  Expense    Expense[]
  IncomeLine IncomeLine[]
  User       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CashSavings {
  id     Int   @id @default(autoincrement())
  amount Decimal @default(0) @db.Decimal(15, 2)
  userId Int   @unique
  User   User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Currency {
  id         Int    @id @default(autoincrement())
  cur_symbol String
  cur_name   String
  User       User[]
}

model Event {
  id            Int      @id @default(autoincrement())
  timestamp     DateTime @default(now())
  actionType    String
  entityType    String
  entitySubtype String?
  userId        Int
  entityId      Int
  beforeValue   Json?
  afterValue    Json?
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([userId, timestamp])
}

model FinancialSnapshot {
  id        String   @id @default(uuid())
  userId    Int
  date      DateTime
  data      Json
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
